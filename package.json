{
  "name": "find-that-tool",
  "version": "1.0.0",
  "description": "A web app that lets you have all common JSON, CSV, YAML, XML, Text and other tools and converters at one place.",
  "repository": "git@github.com:kaushalmeena/find-that-tool.git",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check-types": "tsc --noEmit --incremental",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run check-types && npm run lint && npm run test"
  },
  "dependencies": {
    "@blueprintjs/core": "^6.17.2",
    "@blueprintjs/icons": "^6.13.0",
    "@blueprintjs/select": "^6.3.3",
    "diff": "^9.0.0",
    "next": "^16.2.11",
    "normalize.css": "^8.0.1",
    "papaparse": "^5.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "xml-formatter": "^3.7.0",
    "xml-js": "^1.6.11",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.1",
    "@types/papaparse": "^5.3.7",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
